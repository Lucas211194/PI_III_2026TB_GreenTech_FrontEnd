# URL base da API Django
VITE_API_URL=/api
VITE_API_TARGET=http://localhost:8000

# Coordenadas da estufa para o widget meteorológico
VITE_CLIMA_LAT=-22.433
VITE_CLIMA_LON=-47.715

# Feature Flags (true liga a rota real; ausente/false ativa RecursoIndisponivel)
VITE_FEATURE_IA_CHAT=false
VITE_FEATURE_PREVISAO_ESTOQUE=false
VITE_FEATURE_IRRIGACAO_IA=false
VITE_FEATURE_DASHBOARD_RESUMO=false
VITE_FEATURE_OCR_IMAGEM=false